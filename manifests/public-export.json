        "README.md",
        "AGENTS.md",
        "config/",
        "docs/",
        "src/research_compute_network/help_content/public/getting-started.md"
      ],
      "reason": "Deployment configuration, entry documentation and onboarding differ. Internal connection policy uses managed SSH; public onboarding defaults to HTTPS. Internal operational records are not exported."
    },
    {
      "paths": [
        "docs/member-task-package-guide.zh.md",
        "src/research_compute_network/help_content/public/member-task-package.md"
      ],
      "reason": "Both distributions require the task-package guide and packaged help. Their navigation and origin-adapter links differ to keep private filesystem and operational references out of the public edition. Verify packaged help against each edition's source instead of copying it."
    },
    {
      "paths": [
        "src/research_compute_network/member_client_connection.py"
      ],
      "reason": "Connection behavior is maintained in both trees; the public legacy migration uses generic identifiers instead of private deployment path names. Review changes in both trees without copying this file wholesale."
    },
